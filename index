<!DOCTYPE html>
<html lang="si">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gamiprabha POS System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 min-h-screen p-2 md:p-6 font-sans">

  <div class="max-w-md mx-auto bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200">
    
    <!-- Header -->
    <div class="bg-emerald-800 text-white p-4 text-center relative">
      <h1 class="text-xl font-bold tracking-wide">GAMIPRABHA (PVT) LTD</h1>
      <p class="text-xs text-emerald-200">Coconut Products & POS System</p>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-600">
      <button onclick="switchTab('pos')" id="tab-pos" class="flex-1 py-3 text-center border-b-2 border-emerald-600 text-emerald-800 bg-white">
        <i class="fa-solid fa-calculator mb-1 block text-base"></i> POS Billing
      </button>
      <button onclick="switchTab('inventory')" id="tab-inventory" class="flex-1 py-3 text-center border-b-2 border-transparent hover:text-emerald-700">
        <i class="fa-solid fa-boxes-stacked mb-1 block text-base"></i> Inventory
      </button>
      <button onclick="switchTab('dashboard')" id="tab-dashboard" class="flex-1 py-3 text-center border-b-2 border-transparent hover:text-emerald-700">
        <i class="fa-solid fa-chart-line mb-1 block text-base"></i> Reports
      </button>
    </div>

    <!-- TAB 1: POS BILLING -->
    <div id="view-pos" class="p-4 space-y-4">
      <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">භාණ්ඩ තෝරන්න (Select Products)</h2>
      
      <!-- Product Grid -->
      <div id="product-list" class="grid grid-cols-2 gap-2 max-h-56 overflow-y-auto pr-1">
        <!-- Products populated by JS -->
      </div>

      <!-- Cart Section -->
      <div class="border-t border-slate-200 pt-3">
        <h2 class="text-sm font-bold text-slate-700 mb-2">Cart & Bill Summary</h2>
        <div id="cart-items" class="space-y-1 text-xs max-h-32 overflow-y-auto min-h-[60px] bg-slate-50 p-2 rounded-lg border">
          <p class="text-slate-400 text-center py-3">Cart එක හිස්ව පවතී</p>
        </div>

        <div class="mt-3 space-y-1 text-xs">
          <div class="flex justify-between font-semibold text-slate-700">
            <span>Subtotal:</span>
            <span id="cart-subtotal">Rs. 0.00</span>
          </div>
          <div class="flex justify-between text-emerald-700 font-bold text-sm pt-1 border-t">
            <span>Total Amount:</span>
            <span id="cart-total">Rs. 0.00</span>
          </div>
        </div>

        <button onclick="processCheckout()" class="w-full mt-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-sm flex items-center justify-center gap-2 shadow-md">
          <i class="fa-solid fa-print"></i> Complete & Print Receipt
        </button>
      </div>
    </div>

    <!-- TAB 2: INVENTORY -->
    <div id="view-inventory" class="p-4 hidden space-y-3">
      <div class="flex justify-between items-center">
        <h2 class="text-sm font-bold text-slate-700 uppercase">තොග විස්තර (Current Stock)</h2>
        <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-semibold">Real-time</span>
      </div>
      <div id="inventory-list" class="space-y-2 text-xs max-h-96 overflow-y-auto">
        <!-- Inventory items populated by JS -->
      </div>
    </div>

    <!-- TAB 3: DASHBOARD -->
    <div id="view-dashboard" class="p-4 hidden space-y-3">
      <h2 class="text-sm font-bold text-slate-700 uppercase">දෛනික වාර්තාව (Today's Summary)</h2>
      
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-xl">
          <p class="text-[10px] text-emerald-600 font-bold uppercase">Total Sales</p>
          <p id="dash-sales" class="text-lg font-black text-emerald-900 mt-1">Rs. 0.00</p>
        </div>
        <div class="bg-blue-50 border border-blue-200 p-3 rounded-xl">
          <p class="text-[10px] text-blue-600 font-bold uppercase">Net Profit</p>
          <p id="dash-profit" class="text-lg font-black text-blue-900 mt-1">Rs. 0.00</p>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 p-3 rounded-xl">
        <p class="text-[10px] text-slate-500 font-bold uppercase">Total Inventory Value (Cost)</p>
        <p id="dash-stock-val" class="text-md font-bold text-slate-800 mt-0.5">Rs. 0.00</p>
      </div>
    </div>

  </div>

  <!-- THERMAL RECEIPT MODAL SIMULATION -->
  <div id="receipt-modal" class="fixed inset-0 bg-black/60 hidden items-center justify-center p-4 z-50">
    <div class="bg-white p-4 rounded-lg w-72 shadow-2xl font-mono text-xs text-black border border-slate-300">
      <div class="text-center space-y-0.5">
        <p class="font-bold text-sm">GAMIPRABHA (PVT) LTD</p>
        <p class="text-[10px]">Coconut Product Manufacturers</p>
        <p class="text-[10px]">Tel: +94 34 228 9900</p>
        <p class="text-[10px]">--------------------------------</p>
      </div>
      <div class="my-2 space-y-0.5 text-[11px]">
        <p>Invoice: <span id="rec-inv">INV-001</span></p>
        <p>Date: <span id="rec-date"></span></p>
        <p>--------------------------------</p>
      </div>
      <div id="rec-items" class="space-y-1 text-[11px]">
        <!-- Receipt items -->
      </div>
      <div class="mt-2 pt-1 border-t border-dashed border-black text-right font-bold text-sm">
        TOTAL: <span id="rec-total">Rs. 0.00</span>
      </div>
      <div class="text-center mt-3 pt-2 border-t border-dashed border-black text-[10px]">
        Thank You for Your Business!
      </div>
      <button onclick="closeReceipt()" class="w-full mt-4 bg-slate-800 text-white py-1.5 rounded font-sans font-semibold text-xs">
        Close / Clear
      </button>
    </div>
  </div>

  <script>
    let products = [
      { id: 1, name: 'Coconut Oil 1L', price: 650, cost: 500, stock: 45, alert: 10 },
      { id: 2, name: 'Desiccated 500g', price: 400, cost: 280, stock: 8, alert: 10 },
      { id: 3, name: 'Coconut Milk 200ml', price: 220, cost: 150, stock: 60, alert: 15 },
      { id: 4, name: 'Coconut Charcoal 1kg', price: 350, cost: 200, stock: 5, alert: 10 }
    ];

    let cart = [];
    let totalSales = 0;
    let totalProfit = 0;
    let invoiceCounter = 1001;

    function renderProducts() {
      const container = document.getElementById('product-list');
      container.innerHTML = products.map(p => `
        <div onclick="addToCart(${p.id})" class="p-2 border rounded-xl bg-white hover:border-emerald-500 cursor-pointer text-left transition shadow-sm">
          <p class="font-bold text-xs text-slate-800 truncate">${p.name}</p>
          <p class="text-emerald-700 font-extrabold text-xs">Rs. ${p.price}</p>
          <p class="text-[10px] ${p.stock <= p.alert ? 'text-red-600 font-bold' : 'text-slate-400'}">
            තොගය: ${p.stock} ${p.stock <= p.alert ? '(Low!)' : ''}
          </p>
        </div>
      `).join('');
    }

    function addToCart(id) {
      const prod = products.find(p => p.id === id);
      if (prod.stock <= 0) { alert('තොග අවසන් වී ඇත!'); return; }

      const existing = cart.find(item => item.id === id);
      if (existing) {
        if (existing.qty < prod.stock) existing.qty++;
      } else {
        cart.push({ ...prod, qty: 1 });
      }
      renderCart();
    }

    function renderCart() {
      const container = document.getElementById('cart-items');
      if (cart.length === 0) {
        container.innerHTML = `<p class="text-slate-400 text-center py-3">Cart එක හිස්ව පවතී</p>`;
        document.getElementById('cart-subtotal').innerText = 'Rs. 0.00';
        document.getElementById('cart-total').innerText = 'Rs. 0.00';
        return;
      }

      let subtotal = 0;
      container.innerHTML = cart.map(item => {
        const itemTotal = item.price * item.qty;
        subtotal += itemTotal;
        return `
          <div class="flex justify-between items-center py-1 border-b border-slate-100">
            <span class="font-medium text-slate-700">${item.name} x${item.qty}</span>
            <span class="font-bold">Rs. ${itemTotal.toFixed(2)}</span>
          </div>
        `;
      }).join('');

      document.getElementById('cart-subtotal').innerText = `Rs. ${subtotal.toFixed(2)}`;
      document.getElementById('cart-total').innerText = `Rs. ${subtotal.toFixed(2)}`;
    }

    function processCheckout() {
      if (cart.length === 0) { alert('Cart එකට භාණ්ඩ එකතු කරන්න'); return; }

      let saleCost = 0;
      let saleTotal = 0;

      cart.forEach(item => {
        const p = products.find(prod => prod.id === item.id);
        p.stock -= item.qty;
        saleTotal += item.price * item.qty;
        saleCost += item.cost * item.qty;
      });

      totalSales += saleTotal;
      totalProfit += (saleTotal - saleCost);

      showReceiptModal(saleTotal);
      cart = [];
      renderCart();
      renderProducts();
      renderInventory();
      updateDashboard();
    }

    function showReceiptModal(total) {
      document.getElementById('rec-inv').innerText = `INV-${invoiceCounter++}`;
      document.getElementById('rec-date').innerText = new Date().toLocaleString();
      document.getElementById('rec-total').innerText = `Rs. ${total.toFixed(2)}`;
      
      const recItems = document.getElementById('rec-items');
      recItems.innerHTML = cart.map(i => `
        <div class="flex justify-between">
          <span>${i.name} x${i.qty}</span>
          <span>${(i.price * i.qty).toFixed(2)}</span>
        </div>
      `).join('');

      document.getElementById('receipt-modal').classList.remove('hidden');
      document.getElementById('receipt-modal').classList.add('flex');
    }

    function closeReceipt() {
      document.getElementById('receipt-modal').classList.add('hidden');
      document.getElementById('receipt-modal').classList.remove('flex');
    }

    function renderInventory() {
      const container = document.getElementById('inventory-list');
      container.innerHTML = products.map(p => `
        <div class="p-2.5 bg-slate-50 rounded-lg border flex justify-between items-center">
          <div>
            <p class="font-bold text-slate-800">${p.name}</p>
            <p class="text-[10px] text-slate-500">Cost: Rs.${p.cost} | Selling: Rs.${p.price}</p>
          </div>
          <div class="text-right">
            <span class="text-xs font-black ${p.stock <= p.alert ? 'text-red-600' : 'text-emerald-700'}">
              ${p.stock} Units
            </span>
          </div>
        </div>
      `).join('');
    }

    function updateDashboard() {
      document.getElementById('dash-sales').innerText = `Rs. ${totalSales.toFixed(2)}`;
      document.getElementById('dash-profit').innerText = `Rs. ${totalProfit.toFixed(2)}`;
      
      const stockVal = products.reduce((acc, p) => acc + (p.stock * p.cost), 0);
      document.getElementById('dash-stock-val').innerText = `Rs. ${stockVal.toFixed(2)}`;
    }

    function switchTab(tab) {
      ['pos', 'inventory', 'dashboard'].forEach(t => {
        document.getElementById(`view-${t}`).classList.add('hidden');
        document.getElementById(`tab-${t}`).classList.remove('border-emerald-600', 'text-emerald-800', 'bg-white');
        document.getElementById(`tab-${t}`).classList.add('border-transparent');
      });

      document.getElementById(`view-${tab}`).classList.remove('hidden');
      document.getElementById(`tab-${tab}`).classList.add('border-emerald-600', 'text-emerald-800', 'bg-white');
    }

    // Init
    renderProducts();
    renderInventory();
    updateDashboard();
  </script>
</body>
</html>
